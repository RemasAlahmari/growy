# Copy this file to backend/.env and fill in the values.
# backend/.env is in .gitignore: NEVER commit the real file.

# Supabase Postgres connection string (ask Layan for the real one), e.g.
#   postgresql://USER:PASSWORD@HOST:5432/postgres
# At home, use the "Session pooler" string from Supabase -> Connect if the direct one fails.
# Leave it EMPTY to use a local test database file (backend/growy_local.db) instead.
DATABASE_URL=

# Gemini API key: create one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. If this model gives an error on your key, try gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase login checks. No key is needed: with none of the options below, the
# server checks login tokens using only the project ID (it needs internet access
# to download Google's public certificates).
FIREBASE_PROJECT_ID=growy-4036d
# Optional service-account key (pick ONE if you have it):
#  - On Railway/Render: paste the whole JSON key into FIREBASE_SERVICE_ACCOUNT
#  - Or point to a file with FIREBASE_CREDENTIALS (default: backend/firebase-service-account.json)
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_CREDENTIALS=firebase-service-account.json

# Optional. Extra websites allowed to call the API from a browser (comma-separated),
# e.g. a deployed Flutter Web app. localhost / 127.0.0.1 on any port are always allowed.
# CORS_ORIGINS=https://growy.example.com

# Optional. Set to true to print every SQL query (debugging only).
# SQL_ECHO=false
