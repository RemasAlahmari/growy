<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (this file is in src/debug, so release builds never see it).
     Lets the app call the local FastAPI backend over plain http://, e.g.
     http://10.0.2.2:8000 on the emulator or http://192.168.x.x:8000 on a phone.
     Release builds keep Android's default: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
